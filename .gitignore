# ==============================================================================
# Root .gitignore for Shankara Invoice & Business Admin Panel
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# --- Build & Distribution Outputs ---
dist/
client/dist/
dist-ssr/
client/dist-ssr/
build/
*.tsbuildinfo

# --- Environment Variables, Keys & Secrets ---
# Never commit credentials or live connection strings!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
server/.env.local
client/.env
client/.env.local
*.env
!*.env.example
!server/.env.example

# --- Logs & Runtime Artifacts ---
logs/
server/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Cache & Temporary Folders ---
.cache/
.vite/
client/.vite/
.eslintcache
.temp/
.tmp/

# --- Testing & Coverage ---
coverage/
*.lcov
.nyc_output

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
